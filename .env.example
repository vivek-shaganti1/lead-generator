# =============================================================================
#  Lead Generator — configuration
#  Copy to .env and fill in. Nothing here is optional except where noted.
# =============================================================================

# ---- core -------------------------------------------------------------------
ENV=dev
DEBUG=true
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string
# Login throttle. In-memory, so this is per uvicorn worker, not global.
AUTH_RATE_LIMIT=10/minute
# Must be the URL the *recipient's* mail client can reach: it serves the
# unsubscribe page and the open-tracking pixel.
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ---- database & queue -------------------------------------------------------
# These values are for LOCAL dev (make dev-backend). docker-compose overrides
# both with its in-network hostnames, so a container never reads them — which is
# why they must be reachable from your own machine, not from inside the network.
# SQLite keeps a fresh clone runnable with no services at all; switch to the
# Postgres line once you have one up (`make up` starts one on localhost:5432).
DATABASE_URL=sqlite:///./leadgen.db
# DATABASE_URL=postgresql+psycopg://leadgen:leadgen@localhost:5432/leadgen
REDIS_URL=redis://localhost:6379/0
# Used by docker-compose to provision the postgres container:
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=leadgen
POSTGRES_DB=leadgen

# ---- dashboard login --------------------------------------------------------
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_before_first_boot
JWT_TTL_MINUTES=720

# ---- who the email comes from ----------------------------------------------
COMPANY_NAME=Your Web Studio
# A real postal address is legally required in the footer (CAN-SPAM, and the
# equivalent rules elsewhere). Do not leave this as a placeholder.
COMPANY_ADDRESS=12 Example Street, Hyderabad, India
COMPANY_WEBSITE=https://yourstudio.com
SENDER_NAME=Vivek
SENDER_EMAIL=hello@yourdomain.com
REPLY_TO_EMAIL=
CALENDAR_LINK=

# ---- SMTP (sending) ---------------------------------------------------------
SMTP_TIMEOUT=30
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=hello@yourdomain.com
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# ---- IMAP (reply + bounce detection) ---------------------------------------
IMAP_HOST=imap.zoho.com
IMAP_PORT=993
IMAP_USER=hello@yourdomain.com
IMAP_PASSWORD=
IMAP_SSL=true
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=120

# ---- sending policy ---------------------------------------------------------
# DRY_RUN=true renders and records every message but delivers nothing.
# Leave it true until you have watched a few batches in the dashboard.
DRY_RUN=true
DAILY_SEND_CAP=200
WARMUP_ENABLED=true
WARMUP_START=20
WARMUP_INCREMENT=15
MIN_SECONDS_BETWEEN_SENDS=45
MAX_PER_DOMAIN_PER_DAY=2
# Business hours in the *recipient's* local timezone.
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=17
SEND_ON_WEEKENDS=false
# Nothing leaves until you approve it in the dashboard. Turn off only once you
# trust the copy and the targeting.
REQUIRE_MANUAL_APPROVAL=true
# Embeds a 1x1 pixel so you can see who opened. Set false to send no pixel at all.
TRACK_OPENS=true

# ---- follow-ups -------------------------------------------------------------
FOLLOWUP_ENABLED=true
FOLLOWUP_DELAYS_DAYS=3,7
MAX_FOLLOWUPS=2

# ---- discovery --------------------------------------------------------------
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=180
OVERPASS_MIN_INTERVAL_SECONDS=5
DISCOVERY_MAX_RESULTS_PER_RUN=500
# Google Places is the paid fallback, used only where OSM coverage is thin.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=

# ---- enrichment -------------------------------------------------------------
# Sent on every outbound scrape/probe so site owners can identify the crawler.
# "{email}" is substituted with SENDER_EMAIL.
HTTP_USER_AGENT=LeadGenBot/1.0 (+contact: {email})
ENABLE_WEBSITE_EMAIL_SCRAPE=true
SCRAPE_TIMEOUT=15
VERIFY_MX=true

# ---- AI (Groq) --------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
AI_CLASSIFY_REPLIES=true
AI_PERSONALIZE_COPY=false

# ---- Telegram ---------------------------------------------------------------
# Bot token from @BotFather; chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_POSITIVE=true
TELEGRAM_NOTIFY_ANY_REPLY=false
TELEGRAM_DAILY_DIGEST_HOUR=20

# ---- compliance -------------------------------------------------------------
# Jurisdictions where unsolicited B2B email needs prior consent. Leads there are
# discovered but never auto-mailed. Read COMPLIANCE.md before shortening this.
BLOCKED_COUNTRIES=DE,AT,CH,IT,GR,FI,HU,PL,SI,SK,HR,LT,LV,EE,PT,ES,CZ,BG,RO,DK,NO,IS

# ---- host ports -------------------------------------------------------------
# Only the host side is remapped; container ports never change. Bump these if
# something else on your machine already owns the default.
API_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
FLOWER_PORT=5555

# ---- frontend ---------------------------------------------------------------
# Must match API_PORT above, and must be reachable from the *browser*.
NEXT_PUBLIC_API_URL=http://localhost:8000
